# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
pkgname=hashcalc
pkgver=0.4.1
pkgrel=1
pkgdesc="File hashing tool with GUI and CLI, supporting 50+ algorithms"
arch=('x86_64' 'aarch64')
url="https://github.com/Antidote1911/hashcalc"
license=('AGPL-3.0-only')
depends=('gcc-libs' 'glibc' 'gtk3' 'libxcb' 'libxkbcommon')
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --locked --bin hashcalc
}

package() {
    cd "$pkgname-$pkgver"

    install -Dm755 "target/release/hashcalc" "$pkgdir/usr/bin/hashcalc"

    install -Dm644 "packaging/hashcalc.desktop" \
        "$pkgdir/usr/share/applications/hashcalc.desktop"

    # Shell completions
    install -Dm644 <(./target/release/hashcalc completions bash) \
        "$pkgdir/usr/share/bash-completion/completions/hashcalc"
    install -Dm644 <(./target/release/hashcalc completions zsh) \
        "$pkgdir/usr/share/zsh/site-functions/_hashcalc"
    install -Dm644 <(./target/release/hashcalc completions fish) \
        "$pkgdir/usr/share/fish/vendor_completions.d/hashcalc.fish"

    # Man pages
    local _mandir="$pkgdir/usr/share/man/man1"
    mkdir -p "$_mandir"
    ./target/release/hashcalc manpages "$_mandir"
}
